{
  "name": "seasonal-bingo-royale",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "v26.13.1"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sbr/server --filter @sbr/web run dev",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p ops/test/tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:quiet": "vitest run --reporter=dot",
    "test:coverage": "vitest run packages/domain packages/application --coverage",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:quiet": "playwright test -c e2e/playwright.config.ts --reporter=dot",
    "demo-league": "pnpm --filter @sbr/server demo-league",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "verify:quiet": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:quiet"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@sbr/contracts": "workspace:*",
    "@types/node": "22.20.7",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.5",
    "lefthook": "2.2.3",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
