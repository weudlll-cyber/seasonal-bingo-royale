# @file   ops/.env.dev.example
# @brief  Placeholder credentials for the local PostgreSQL in ops/compose.dev.yml.
#
# Responsibility: make the dev stack start without setup. Development only: the database
#                 listens on 127.0.0.1. Override in ops/.env.dev (ignored by git).
# Spec:           docs/spec/08-devops-architecture.md §5
POSTGRES_USER=sbr
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=sbr
