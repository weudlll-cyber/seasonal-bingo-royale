#!/usr/bin/env bash
# @file   ops/sbr
# @module ops
# @brief  The operator's command on the server: the kit's admin command with Bingo's settings.
#
# Responsibility: the verbs status, update, confirm, rollback, backup, restore, logs and uninstall
#                 are the kit's (./kit/lib/admin.sh, K87: same meaning and output in every game);
#                 here are the SK_ADMIN_* settings and the sources. Bingo's hooks and its own verbs
#                 (admin, maintenance, loadcheck, drill, rewrite_backup) are in ./lib/hooks.sh and
#                 ./lib/backup.sh. --env picks the environment (else the install record's), --yes
#                 skips the confirmations.
# Depends on:     /opt/sbr/lib/*.sh, /opt/sbr/kit (the kit's ops folder), Docker Compose, age
# Spec:           docs/spec/09-deployment-architecture.md §4–§6
set -euo pipefail
# Errors inside $(…) stop the script too (audit O1).
shopt -s inherit_errexit

HERE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# The kit's scripts (./kit) came in an update of their own: an update that skipped it ran the
# old installer, which did not bring them.
if [[ ! -f $HERE/kit/lib/admin.sh ]]; then
  echo "STOP: this install lacks the kit's scripts: run ops/install.sh again from $HERE/src" >&2
  exit 1
fi
# shellcheck source=lib/common.sh
source "$HERE/lib/common.sh"
# shellcheck source=kit/lib/image.sh
source "$HERE/kit/lib/image.sh"
# shellcheck source=lib/release.sh
source "$HERE/lib/release.sh"
# shellcheck source=lib/config.sh
source "$HERE/lib/config.sh"
# shellcheck source=kit/lib/db-roles.sh
source "$HERE/kit/lib/db-roles.sh"
# shellcheck source=lib/website.sh
source "$HERE/lib/website.sh"
# shellcheck source=kit/lib/website-route.sh
source "$HERE/kit/lib/website-route.sh"
# shellcheck source=lib/websiteApply.sh
source "$HERE/lib/websiteApply.sh"
# shellcheck source=lib/backup.sh
source "$HERE/lib/backup.sh"
# shellcheck source=lib/loadcheck.sh
source "$HERE/lib/loadcheck.sh"
# shellcheck source=lib/hooks.sh
source "$HERE/lib/hooks.sh"

export SK_ADMIN_NAME=sbr SK_ADMIN_PREFIX=sbr SK_ADMIN_ETC="$SBR_ETC" SK_ADMIN_STATE="$SBR_STATE"
export SK_ADMIN_ROOT="$SBR_ROOT" SK_ADMIN_IMAGE_REPO=sbr-app SK_ADMIN_IMAGE_KEY=SBR_IMAGE
export SK_ADMIN_REF_KEY=SBR_REF SK_ADMIN_STACK_FILES="${STACK_FILES[*]}"
SK_ADMIN_DEFAULT_ENV=$(env_value "$SBR_ETC/install.conf" SBR_ENV)
export SK_ADMIN_DEFAULT_ENV
# The kit's library: its info, warn and die are the ones used from here on.
# shellcheck source=kit/lib/admin.sh
source "$HERE/kit/lib/admin.sh"

sk_admin_main "$@"
