# @file   .npmrc
# @module repo
# @brief  npm-level settings, mirroring the pnpm settings in pnpm-workspace.yaml.
#
# Responsibility: same behaviour if someone runs npm by mistake: refuse unsupported Node
#                 versions, pin exact versions. pnpm itself reads pnpm-workspace.yaml.
# Spec:           docs/spec/08-devops-architecture.md §8
engine-strict=true
save-exact=true
