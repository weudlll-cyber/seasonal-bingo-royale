# @file   apps/server/dev.env
# @module server
# @brief  Settings of `pnpm dev`: the development features on (never on a public address).
#
# Responsibility: development mode with the development features, the database of
#                 ops/compose.dev.yml (port 5490, development-only password) and its Mailpit
#                 for outgoing mail (SMTP on port 1090, no user; read at http://localhost:8490),
#                 so "Forgot password?" works locally. A variable already set in the shell
#                 wins (node --env-file never overrides).
# Used by:        apps/server/package.json (script "dev"), the root `pnpm dev`
# Spec:           docs/spec/08-devops-architecture.md §1
NODE_ENV=development
SBR_DEV=1
DATABASE_URL=postgres://sbr:change-me-dev-only@127.0.0.1:5490/sbr
SBR_SMTP_HOST=127.0.0.1
SBR_SMTP_PORT=1090
