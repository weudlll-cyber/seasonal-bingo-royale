{
  "name": "@sbr/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude \"**/node_modules/**\" --exclude \"../../node_modules/**\" --exclude \"**/test-results/**\" --exclude \"**/coverage/**\" --exclude \"../../reports/**\" --exclude \"data/**\" --env-file=dev.env src/main.ts",
    "start": "node --import=tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node build.mjs",
    "demo-league": "node demo-league.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/proxy-addr": "5.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@node-rs/argon2": "2.2.2",
    "@sbr/application": "workspace:*",
    "@sbr/contracts": "workspace:*",
    "@sbr/domain": "workspace:*",
    "fastify": "5.12.7",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "esbuild": "0.28.2",
    "socket.io-client": "4.8.4",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15"
  }
}
